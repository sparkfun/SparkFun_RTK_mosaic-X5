menu "Example Configuration"

    choice EXAMPLE_ESP_WIFI_STA_AUTHMODE_THRESHOLD
        prompt "WiFi STA scan authentication threshold"
        default EXAMPLE_ESP_WIFI_STA_AUTHMODE_THRESHOLD_WPA2_PSK
        help
            Minimum authentication mode accepted when scanning and connecting as a station.
            Lower this to connect to older networks (WEP/WPA).

        config EXAMPLE_ESP_WIFI_STA_AUTHMODE_THRESHOLD_OPEN
            bool "Open"
        config EXAMPLE_ESP_WIFI_STA_AUTHMODE_THRESHOLD_WEP
            bool "WEP"
        config EXAMPLE_ESP_WIFI_STA_AUTHMODE_THRESHOLD_WPA_PSK
            bool "WPA PSK"
        config EXAMPLE_ESP_WIFI_STA_AUTHMODE_THRESHOLD_WPA2_PSK
            bool "WPA2 PSK"
        config EXAMPLE_ESP_WIFI_STA_AUTHMODE_THRESHOLD_WPA_WPA2_PSK
            bool "WPA/WPA2 PSK"
        config EXAMPLE_ESP_WIFI_STA_AUTHMODE_THRESHOLD_WPA3_PSK
            bool "WPA3 PSK"
    endchoice

endmenu
