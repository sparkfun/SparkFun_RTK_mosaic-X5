#
# 4MB Flash
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
#
# WiFi Station Configuration
#
CONFIG_EXAMPLE_ESP_WIFI_STA_AUTHMODE_THRESHOLD_WPA2_PSK=y
#
# Ethernet gateway configuration
#
CONFIG_EXAMPLE_ETH_GATEWAY_IP_ADDR="192.168.5.1"
CONFIG_EXAMPLE_ETH_GATEWAY_NETMASK="255.255.255.0"
CONFIG_EXAMPLE_ETH_GATEWAY_GW="192.168.5.1"
#
# Ethernet
#
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETHERNET_PHY_INTERFACE_RMII=y
CONFIG_ETHERNET_PHY_KSZ80XX=y
CONFIG_ETH_TRANSMIT_MUTEX=y
#
# NAPT Configuration (optional)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
#
# Custom partitions - for nvs and fat
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"